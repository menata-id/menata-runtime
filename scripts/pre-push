#!/usr/bin/env bash
# Repo-root git pre-push dispatcher -- the local, zero-cost CI gate (Study 33
# remediation, see roadmap.md item 12 and
# benchmarks/025-architecture-worldclass-audit.md). No GitHub Actions: this
# repo runs on a free GitHub plan with Actions minutes exhausted, so the gate
# runs entirely on this host instead, at push time.
#
# Only triggers a directory's own conformance suite when a push actually
# touches that directory -- no point spinning up Postgres + a throwaway
# server for a docs-only push in a monorepo covering 7 prototypes plus app/.
#
# Status update (2026-09-12): originally watched prototype/go/ only, dating
# to before app/ existed. app/ROADMAP.md's Phase 6 cutover (2026-09-06) made
# app/ the real, live-serving codebase and prototype/go frozen historical
# record (root CLAUDE.md) -- this hook went a week+ never noticing that, so
# every push touching only app/ (which is most of them now, including the
# entire composable-runtime-roadmap.md program) silently skipped the gate
# entirely. Now watches both, independently, and runs each one whose own
# directory changed -- app/scripts/local-ci.sh is the meaningfully more
# expensive one now (isolated Postgres schema, full seed, real server,
# 270+-test conformance suite, 5 quality gates including the composable
# import-boundary one), so pushes touching app/ now cost noticeably more
# than before this fix -- the escape hatches below are unchanged.
#
# Install (this file is tracked; git's own hook slot is not, so it needs a
# one-time copy after every fresh clone):
#   cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Escape hatches: `git push --no-verify` (skips all hooks, standard git),
# or `SKIP_LOCAL_CI=1 git push` (skips just this gate's logic, still runs
# any other hook).

set -euo pipefail

if [ "${SKIP_LOCAL_CI:-}" = "1" ]; then
  echo "pre-push: SKIP_LOCAL_CI=1 set, skipping local conformance gate"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

ZERO="0000000000000000000000000000000000000000"
touches_go_prototype=false
touches_app=false

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # deleting a ref, nothing to check
  if [ "$remote_sha" = "$ZERO" ]; then
    # new branch/ref on the remote -- no common history to diff against yet;
    # fall back to this branch's merge-base with main (or, failing that, just
    # be conservative and run the gate).
    base="$(git merge-base main "$local_sha" 2>/dev/null || echo "")"
  else
    base="$remote_sha"
  fi
  if [ -z "$base" ] || ! git diff --quiet "$base" "$local_sha" -- prototype/go/ 2>/dev/null; then
    touches_go_prototype=true
  fi
  if [ -z "$base" ] || ! git diff --quiet "$base" "$local_sha" -- app/ 2>/dev/null; then
    touches_app=true
  fi
done

if [ "$touches_go_prototype" = false ] && [ "$touches_app" = false ]; then
  echo "pre-push: no changes under app/ or prototype/go/, skipping local conformance gate"
  exit 0
fi

echo "pre-push: (SKIP_LOCAL_CI=1 git push, or git push --no-verify, to bypass)"

status=0
if [ "$touches_app" = true ]; then
  echo "pre-push: app/ changed -- running app/'s local conformance gate"
  "$REPO_ROOT/app/scripts/local-ci.sh" || status=$?
fi
if [ "$touches_go_prototype" = true ]; then
  echo "pre-push: prototype/go/ changed -- running prototype/go's local conformance gate"
  "$REPO_ROOT/prototype/go/scripts/local-ci.sh" || status=$?
fi
exit "$status"
