package ui

import "strings"

// AdminUsers (CAP-O01) is the workspace Admin's user-management page --
// change a user's workspace-wide role (Admin/Member) and, per Application,
// which role (if any) they hold there. One <form> per user, not a single
// table-wide form -- an HTML <form> can't validly wrap table rows, and this
// keeps a "Save" mistake scoped to the one row a mis-click happened on.
// appGroups is Interpreter.AllRoles(workspaceID) -- the implicit role
// vocabulary for each Application, derived from its own machines'
// Permissions, not a separately maintained list (CAP-O01's own design
// choice — see the plan this shipped against).
templ AdminUsers(workspaceName, identity, csrfToken string, unreadCount int, users []AdminUserRow, appGroups []RoleGroup, groups []AdminGroupRow) {
	@Page("Manage users", workspaceName, identity, csrfToken, true, unreadCount, nil) {
		<h1 class="mb-1 text-xl font-semibold text-slate-900">Manage users</h1>
		<p class="mb-5 text-sm text-slate-500">
			Workspace role controls access to this page and (reserved, not yet built) Application
			metadata management. Application role controls what a person can read, create, edit, or
			trigger within that Application — see each Application's own Machines' Permissions for
			the role vocabulary offered below.
		</p>
		<form method="POST" action="/admin/reload" class="mb-5 flex items-center gap-3 rounded-lg border border-slate-200 bg-white px-5 py-3.5 shadow-sm">
			@CSRFField(csrfToken)
			<div class="text-sm text-slate-600">
				<span class="font-medium text-slate-900">Reload metadata</span> — apply Machine/Field/Event/etc.
				changes already saved to the database, without restarting the server (CAP-X04).
			</div>
			<button
				type="submit"
				class="ml-auto shrink-0 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-1 transition-colors"
			>
				Reload now
			</button>
		</form>
		<div class="divide-y divide-slate-100 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
			for _, u := range users {
				<form
					method="POST"
					action={ templ.SafeURL("/admin/users/" + u.ID) }
					class="flex flex-wrap items-center gap-4 px-5 py-3.5"
				>
					@CSRFField(csrfToken)
					<div class="w-44 shrink-0">
						<div class="text-sm font-medium text-slate-900">{ u.Name }</div>
						<div class="text-xs text-slate-400">{ u.Email }</div>
					</div>
					<div class="flex items-center gap-1.5">
						<label class="text-xs text-slate-500">Workspace</label>
						<select
							name="workspace_role"
							class="rounded-md border border-slate-300 bg-white px-2 py-1 text-xs shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
						>
							<option value="Member" selected?={ u.WorkspaceRole == "Member" }>Member</option>
							<option value="Admin" selected?={ u.WorkspaceRole == "Admin" }>Admin</option>
						</select>
					</div>
					for _, g := range appGroups {
						<div class="flex items-center gap-1.5">
							<label class="text-xs text-slate-500">{ g.AppName }</label>
							<select
								name={ "app_role_" + g.AppID }
								class="rounded-md border border-slate-300 bg-white px-2 py-1 text-xs shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
							>
								<option value="" selected?={ u.AppRoles[g.AppID] == "" }>— none —</option>
								for _, role := range g.Roles {
									<option value={ role } selected?={ u.AppRoles[g.AppID] == role }>{ role }</option>
								}
							</select>
						</div>
					}
					<button
						type="submit"
						class="ml-auto shrink-0 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-1 transition-colors"
					>
						Save
					</button>
				</form>
			}
		</div>

			<h2 class="mb-1 mt-8 text-lg font-semibold text-slate-900">Groups</h2>
			<p class="mb-5 text-sm text-slate-500">
				CAP-O07 — assign a role to a Group once, then add or remove members, instead of touching
				every person's own row above. A person's effective role in an Application is the union of
				their direct assignment (above) and every role any Group they belong to holds.
			</p>
			<div class="divide-y divide-slate-100 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
				for _, g := range groups {
					<a
						href={ templ.SafeURL("/admin/groups/" + g.ID) }
						class="flex flex-wrap items-center gap-4 px-5 py-3.5 hover:bg-slate-50 transition-colors"
					>
						<div class="w-44 shrink-0 text-sm font-medium text-slate-900">{ g.Name }</div>
						<div class="text-xs text-slate-500">
							if len(g.MemberNames) == 0 {
								no members
							} else {
								{ strings.Join(g.MemberNames, ", ") }
							}
						</div>
						<div class="ml-auto flex flex-wrap items-center gap-3 text-xs text-slate-500">
							for _, ag := range appGroups {
								if role := g.AppRoles[ag.AppID]; role != "" {
									<span>{ ag.AppName }: <span class="font-medium text-slate-700">{ role }</span></span>
								}
							}
						</div>
					</a>
				}
				if len(groups) == 0 {
					<div class="px-5 py-3.5 text-sm text-slate-400">No groups yet.</div>
				}
			</div>
			<form method="POST" action="/admin/groups" class="mt-3 flex items-center gap-3">
				@CSRFField(csrfToken)
				<input
					type="text"
					name="name"
					required?={ true }
					placeholder="New group name"
					class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
				/>
				<button
					type="submit"
					class="shrink-0 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-1 transition-colors"
				>
					+ New group
				</button>
			</form>
		}
	}

// GroupDetail (CAP-O07) -- one Group's own edit page: membership
// (checkbox per workspace user) and per-Application role selects, same
// vocabulary source (appGroups = Interpreter.AllRoles) AdminUsers'
// per-user selects already use. Two separate forms (membership vs.
// roles) rather than one -- they write to different tables
// (SetMembers vs. SetApplicationRole) and a mis-click in one shouldn't
// require resubmitting the other.
templ GroupDetail(workspaceName, identity, csrfToken string, unreadCount int, data GroupDetailData, appGroups []RoleGroup) {
	@Page("Group: "+data.Name, workspaceName, identity, csrfToken, true, unreadCount, nil) {
		<a href="/admin/users" class="mb-4 inline-block text-xs text-slate-500 hover:text-slate-700">&larr; Manage users</a>
		<h1 class="mb-5 text-xl font-semibold text-slate-900">{ data.Name }</h1>

		<h2 class="mb-2 text-sm font-semibold text-slate-900">Members</h2>
		<form method="POST" action={ templ.SafeURL("/admin/groups/" + data.ID + "/members") } class="mb-8 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
			@CSRFField(csrfToken)
			<div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
				for _, m := range data.Members {
					<label class="flex items-center gap-2 text-sm text-slate-700">
						<input type="checkbox" name="member_id" value={ m.ID } checked?={ m.Checked }/>
						{ m.Name }
					</label>
				}
			</div>
			<button
				type="submit"
				class="mt-4 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-1 transition-colors"
			>
				Save members
			</button>
		</form>

		<h2 class="mb-2 text-sm font-semibold text-slate-900">Application roles</h2>
		<form method="POST" action={ templ.SafeURL("/admin/groups/" + data.ID + "/roles") } class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
			@CSRFField(csrfToken)
			<div class="flex flex-wrap gap-4">
				for _, g := range appGroups {
					<div class="flex items-center gap-1.5">
						<label class="text-xs text-slate-500">{ g.AppName }</label>
						<select
							name={ "app_role_" + g.AppID }
							class="rounded-md border border-slate-300 bg-white px-2 py-1 text-xs shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
						>
							<option value="" selected?={ data.AppRoles[g.AppID] == "" }>— none —</option>
							for _, role := range g.Roles {
								<option value={ role } selected?={ data.AppRoles[g.AppID] == role }>{ role }</option>
							}
						</select>
					</div>
				}
			</div>
			<button
				type="submit"
				class="mt-4 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-1 transition-colors"
			>
				Save roles
			</button>
		</form>
	}
}
