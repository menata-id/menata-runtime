package ui

import "fmt"
import "strings"
import "menata.id/runtime/internal/model"

// ImportCSV (CAP-R06) renders both the upload form and, once results is
// non-nil, the per-row outcome -- one page, not two, so a re-upload after
// fixing a bad row is a single click back.
templ ImportCSV(identity, csrfToken string, isAdmin bool, machine *model.Machine, fieldIDs []string, results []ImportRowResult, unreadCount int) {
	@Page("Import "+machine.Name, identity, csrfToken, isAdmin, unreadCount) {
		<div class="mx-auto max-w-xl">
			<div class="mb-5 flex items-center gap-3">
				<a href={ templ.SafeURL("/" + machine.ID) } class="text-sm text-slate-400 hover:text-slate-600 transition-colors">← Back</a>
				<h1 class="text-xl font-semibold text-slate-900">Import { machine.Name }</h1>
			</div>
			<div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
				<p class="mb-3 text-sm text-slate-500">
					CSV header row must use these field ids, in any order:
					<code class="ml-1 rounded bg-slate-100 px-1.5 py-0.5 text-xs">{ strings.Join(fieldIDs, ", ") }</code>
				</p>
				<p class="mb-4 text-sm">
					<a href={ templ.SafeURL("/" + machine.ID + "/export.csv") } class="text-blue-600 hover:text-blue-800 hover:underline">Download current data as a template →</a>
				</p>
				<form method="POST" action={ templ.SafeURL("/" + machine.ID + "/import") } enctype="multipart/form-data" class="space-y-4">
					@CSRFField(csrfToken)
					<input type="file" name="file" accept=".csv" required class="block w-full text-sm text-slate-700"/>
					<button
						type="submit"
						class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 transition-colors"
					>Upload</button>
				</form>
			</div>
			if results != nil {
				<div class="mt-6">
					<h2 class="mb-2 text-sm font-semibold text-slate-700">
						{ fmt.Sprintf("%d", successCount(results)) } created, { fmt.Sprintf("%d", len(results)-successCount(results)) } failed
					</h2>
					<div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
						<table class="w-full text-sm">
							<tbody class="divide-y divide-slate-100">
								for _, res := range results {
									<tr>
										<td class="px-4 py-2 text-slate-400">Row { fmt.Sprintf("%d", res.Row) }</td>
										<td class="px-4 py-2">
											if res.Success {
												<span class="text-green-700">Created</span>
											} else {
												<span class="text-red-600">{ res.Message }</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		</div>
	}
}

func successCount(results []ImportRowResult) int {
	n := 0
	for _, r := range results {
		if r.Success {
			n++
		}
	}
	return n
}
