package ui

import "fmt"
import "menata.id/runtime/internal/model"

templ List(identity, csrfToken string, isAdmin bool, machine *model.Machine, columns []ColumnDef, rows []ListRow, permittedEvents []*model.Event, unreadCount int, searchQuery string, manualOrder bool) {
	@Page(machine.Name, identity, csrfToken, isAdmin, unreadCount) {
		<div class="mb-4 flex items-center gap-3">
			<h1 class="flex-1 text-xl font-semibold text-slate-900">{ machine.Name }</h1>
			<form method="get" action={ templ.SafeURL("/" + machine.ID) } class="flex items-center">
				<input
					type="search"
					name="q"
					value={ searchQuery }
					placeholder="Search..."
					class="w-48 rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
				/>
			</form>
			<a
				href={ templ.SafeURL("/" + machine.ID + "/new") }
				class="inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3.5 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 transition-colors"
			>
				<span>+</span>
				<span>New</span>
			</a>
		</div>
		<div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
			<table class="w-full text-sm">
				<thead class="border-b border-slate-200 bg-slate-50">
					<tr>
						for _, col := range columns {
							<th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
								{ col.Name }
							</th>
						}
						if manualOrder {
							<th class="w-px px-4 py-3"></th>
						}
						<th class="w-px px-4 py-3"></th>
					</tr>
				</thead>
				if len(rows) == 0 {
					<tbody>
						<tr>
							<td colspan={ fmt.Sprintf("%d", len(columns)+1) } class="py-16 text-center text-sm text-slate-400">
								No records yet. Create the first one.
							</td>
						</tr>
					</tbody>
				} else {
					<tbody class="divide-y divide-slate-100">
						for _, row := range rows {
							<tr class="transition-colors hover:bg-slate-50">
								for _, cell := range row.Cells {
									<td class="px-4 py-3 text-slate-700">
										if cell.IsStatusBadge && cell.Value != "" {
											@StatusBadge(cell.Value)
										} else if cell.Link != "" {
											<a href={ templ.SafeURL(cell.Link) } class="text-blue-600 hover:text-blue-800 hover:underline">{ cell.Value }</a>
										} else if cell.Value != "" {
											{ cell.Value }
										} else {
											<span class="text-slate-300">—</span>
										}
									</td>
								}
								if manualOrder {
									<td class="whitespace-nowrap px-4 py-3">
										<form method="post" action={ templ.SafeURL("/" + machine.ID + "/" + row.ID + "/move/up") } class="inline">
											@CSRFField(csrfToken)
											<button type="submit" class="text-xs text-slate-500 hover:text-slate-800" aria-label="Move up">↑</button>
										</form>
										<form method="post" action={ templ.SafeURL("/" + machine.ID + "/" + row.ID + "/move/down") } class="inline">
											@CSRFField(csrfToken)
											<button type="submit" class="text-xs text-slate-500 hover:text-slate-800" aria-label="Move down">↓</button>
										</form>
									</td>
								}
								<td class="px-4 py-3">
									<a
										href={ templ.SafeURL("/" + machine.ID + "/" + row.ID) }
										class="text-xs font-medium text-blue-600 hover:text-blue-800 hover:underline"
									>View →</a>
								</td>
							</tr>
						}
					</tbody>
				}
			</table>
		</div>
	}
}
