package ui

import "strconv"

// Dashboard (CAP-V10) renders a composed multi-machine summary -- one tile
// per declared Section, each linking to its own Machine's own list view.
// Deliberately count-based, not charts -- a real, useful "at a glance"
// summary without a charting dependency, matching this prototype's
// no-heavy-frontend-framework posture.
templ Dashboard(identity, csrfToken string, isAdmin bool, viewName string, tiles []DashboardTile, unreadCount int) {
	@Page(viewName, identity, csrfToken, isAdmin, unreadCount) {
		<div class="mb-4">
			<h1 class="text-xl font-semibold text-slate-900">{ viewName }</h1>
		</div>
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			for _, tile := range tiles {
				<a href={ templ.SafeURL("/" + tile.MachineID) } class="block rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition-colors hover:bg-slate-50">
					<div class="text-xs font-semibold uppercase tracking-wide text-slate-500">{ tile.Title }</div>
					<div class="mt-1 text-2xl font-semibold text-slate-900">{ strconv.Itoa(tile.Total) }</div>
					if len(tile.Breakdown) > 0 {
						<div class="mt-3 space-y-1">
							for _, b := range tile.Breakdown {
								<div class="flex items-center justify-between text-xs text-slate-500">
									<span>
										if b.Label == "" {
											—
										} else {
											{ b.Label }
										}
									</span>
									<span class="font-medium text-slate-700">{ strconv.Itoa(b.Count) }</span>
								</div>
							}
						</div>
					}
				</a>
			}
		</div>
	}
}
