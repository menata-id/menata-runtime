# Use a dedicated role scoped to menata_runtime, not the shared "postgres"
# superuser -- on a shared host, that role is cluster-wide, so changing its
# password here breaks every other app on the host.
# See DEVELOPMENT.md "Database role" section.
DATABASE_URL=postgres://menata_runtime_app:CHANGE_ME@localhost:5432/menata_runtime?sslmode=disable
PORT=3100

# CAP-X02: session cookie's Secure attribute. Leave false for local dev
# (plain http://localhost) -- a Secure cookie sent over http is refused by
# browsers, which silently breaks login. Production (HTTPS) must set true.
SECURE_COOKIES=false
