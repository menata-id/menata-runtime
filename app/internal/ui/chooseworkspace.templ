package ui

// WorkspaceOption is one membership's own Workspace, rendered as a picker
// choice (CAP-O11).
type WorkspaceOption struct {
	ID   string
	Name string
	Slug string
}

// ChooseWorkspacePage (CAP-O11) is deliberately its own standalone shell,
// same reasoning as LoginPage/SignupPage: this identity IS authenticated,
// but there's no single Workspace yet to brand the shared nav bar with.
templ ChooseWorkspacePage(errorMsg, csrfToken string, options []WorkspaceOption) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Choose a workspace — Menata Runtime</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
		</head>
		<body class="flex min-h-screen items-center justify-center bg-slate-50 text-slate-900 antialiased">
			<div class="mx-auto w-full max-w-sm px-4">
				<div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
					<h1 class="text-lg font-semibold text-slate-900">Choose a workspace</h1>
					<p class="mt-1 text-sm text-slate-500">This account belongs to more than one workspace.</p>
					if errorMsg != "" {
						<div class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
							{ errorMsg }
						</div>
					}
					<div class="mt-5 space-y-2">
						for _, opt := range options {
							<form method="POST" action="/choose-workspace">
								@CSRFField(csrfToken)
								<input type="hidden" name="workspace_id" value={ opt.ID }/>
								<button
									type="submit"
									class="block w-full rounded-md border border-slate-300 bg-white px-4 py-2.5 text-left text-sm font-medium text-slate-900 shadow-sm hover:border-blue-400 hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 transition-colors"
								>
									{ opt.Name }
									<span class="block text-xs font-normal text-slate-400">menata.app/{ opt.Slug }/</span>
								</button>
							</form>
						}
					</div>
				</div>
			</div>
		</body>
	</html>
}
