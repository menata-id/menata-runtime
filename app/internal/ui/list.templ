package ui

import "fmt"
import "net/url"
import "strings"
import "menata.id/app/internal/model"

templ List(workspaceName, wsSlug, identity, csrfToken string, isAdmin bool, machine *model.Machine, columns []ColumnDef, rows []ListRow, permittedEvents []*model.Event, unreadCount int, opts ListViewOptions, subNav []SubNavLink, viewNav []ViewNavLink) {
	@Page(machine.Name, workspaceName, wsSlug, identity, csrfToken, isAdmin, unreadCount, subNav) {
		if len(viewNav) > 0 {
			@viewNavPill(viewNav)
		}
		<div class="mb-4 flex items-center gap-3">
			<h1 class="flex-1 text-xl font-semibold text-slate-900">
				{ machine.Name }
				if opts.Archived {
					<span class="ml-2 text-sm font-normal text-slate-400">(Archived)</span>
				}
			</h1>
			if opts.CanDelete {
				if opts.Archived {
					<a href={ templ.SafeURL("/" + wsSlug + "/" + machine.ID) } class="text-sm text-slate-500 hover:text-slate-700 transition-colors">← Back to list</a>
				} else {
					<a href={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "?archived=1") } class="text-sm text-slate-500 hover:text-slate-700 transition-colors">View Archive</a>
				}
			}
			<form method="get" action={ templ.SafeURL("/" + wsSlug + "/" + machine.ID) } class="flex items-center">
				<input
					type="search"
					name="q"
					value={ opts.SearchQuery }
					placeholder="Search..."
					class="w-48 rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
				/>
			</form>
			if !opts.Archived {
				<a href={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "/export.csv") } class="text-sm text-slate-500 hover:text-slate-700 transition-colors">Export</a>
				<a href={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "/import") } class="text-sm text-slate-500 hover:text-slate-700 transition-colors">Import</a>
				<a
					href={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "/new") }
					class="inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3.5 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 transition-colors"
				>
					<span>+</span>
					<span>New</span>
				</a>
			}
		</div>
		if opts.Cards {
			@listCards(wsSlug, machine.ID, rows, opts.Archived)
		} else {
		<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
			<table class="w-full text-sm">
				<thead class="border-b border-slate-200 bg-slate-50">
					<tr>
						for _, col := range columns {
							<th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
								{ col.Name }
							</th>
						}
						if opts.ManualOrder {
							<th class="w-px px-4 py-3"></th>
						}
						if opts.CanDelete {
							<th class="w-px px-4 py-3"></th>
						}
						<th class="w-px px-4 py-3"></th>
					</tr>
				</thead>
				if len(rows) == 0 {
					<tbody>
						<tr>
							<td colspan={ fmt.Sprintf("%d", len(columns)+1) } class="py-16 text-center text-sm text-slate-400">
								if opts.Archived {
									Nothing archived.
								} else {
									No records yet. Create the first one.
								}
							</td>
						</tr>
					</tbody>
				} else {
					<tbody class="divide-y divide-slate-100">
						for _, row := range rows {
							<tr class="transition-colors hover:bg-slate-50">
								for _, cell := range row.Cells {
									<td class="px-4 py-3 text-slate-700">
										if cell.SlaUrgency != "" {
											@SlaBadge(cell.Value, cell.SlaUrgency)
										} else if cell.IsStatusBadge && cell.Value != "" {
											@StatusBadge(cell.Value)
										} else if cell.Link != "" {
											<a href={ templ.SafeURL(cell.Link) } class="text-blue-600 hover:text-blue-800 hover:underline">{ cell.Value }</a>
										} else if cell.Value != "" {
											{ cell.Value }
										} else {
											<span class="text-slate-300">—</span>
										}
									</td>
								}
								if opts.ManualOrder {
									<td class="whitespace-nowrap px-4 py-3">
										<form method="post" action={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "/" + row.ID + "/move/up") } class="inline">
											@CSRFField(csrfToken)
											<button type="submit" class="text-xs text-slate-500 hover:text-slate-800" aria-label="Move up">↑</button>
										</form>
										<form method="post" action={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "/" + row.ID + "/move/down") } class="inline">
											@CSRFField(csrfToken)
											<button type="submit" class="text-xs text-slate-500 hover:text-slate-800" aria-label="Move down">↓</button>
										</form>
									</td>
								}
								if opts.CanDelete {
									<td class="whitespace-nowrap px-4 py-3">
										if opts.Archived {
											<form method="post" action={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "/" + row.ID + "/restore") } class="inline">
												@CSRFField(csrfToken)
												<button type="submit" class="text-xs text-slate-500 hover:text-slate-800">Restore</button>
											</form>
										} else {
											<form method="post" action={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "/" + row.ID + "/archive") } class="inline">
												@CSRFField(csrfToken)
												<button type="submit" class="text-xs text-slate-500 hover:text-red-600">Archive</button>
											</form>
										}
									</td>
								}
								<td class="px-4 py-3">
									<a
										href={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "/" + row.ID) }
										class="text-xs font-medium text-blue-600 hover:text-blue-800 hover:underline"
									>View →</a>
								</td>
							</tr>
						}
					</tbody>
				}
			</table>
		</div>
		}
		if opts.TotalPages > 1 {
			<div class="mt-4 flex items-center justify-center gap-4 text-sm text-slate-500">
				if opts.Page > 1 {
					<a href={ templ.SafeURL(pageLink(wsSlug, machine.ID, opts, opts.Page-1)) } class="hover:text-slate-800">← Prev</a>
				} else {
					<span class="text-slate-300">← Prev</span>
				}
				<span>Page { fmt.Sprintf("%d", opts.Page) } of { fmt.Sprintf("%d", opts.TotalPages) }</span>
				if opts.Page < opts.TotalPages {
					<a href={ templ.SafeURL(pageLink(wsSlug, machine.ID, opts, opts.Page+1)) } class="hover:text-slate-800">Next →</a>
				} else {
					<span class="text-slate-300">Next →</span>
				}
			</div>
		}
	}
}

func pageLink(wsSlug, machineID string, opts ListViewOptions, page int) string {
	link := "/" + wsSlug + "/" + machineID + "?page=" + fmt.Sprintf("%d", page)
	if opts.SearchQuery != "" {
		link += "&q=" + url.QueryEscape(opts.SearchQuery)
	}
	if opts.Archived {
		link += "&archived=1"
	}
	return link
}

// ListContent (CAP-V10 Tier 2) is a `list` View's own rows, embedded --
// used when a `page` View composes an existing `list` View as one of its
// own sections (internal/handler/page.go). Deliberately NOT List itself:
// List's own toolbar (search/export/import/New) and per-row Archive/
// Move controls are for VISITING that Machine directly, not for a summary
// sitting inside someone else's page -- reusing List verbatim here would
// mean CSRF-bearing forms and a page-own-`New` action sitting inside a
// SectionWrapper that has no business owning either. Same underlying
// ColumnDef/ListRow/Cards data record_crud.go's buildListRows/
// applyListFilter already produce -- only the wrapping chrome differs.
templ ListContent(wsSlug, machineID string, columns []ColumnDef, rows []ListRow, cards bool) {
	if cards {
		@listCards(wsSlug, machineID, rows, false)
	} else if len(rows) == 0 {
		<div class="py-10 text-center text-sm text-slate-400">No records yet.</div>
	} else {
		<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
			<table class="w-full text-sm">
				<thead class="border-b border-slate-200 bg-slate-50">
					<tr>
						for _, col := range columns {
							<th class="px-4 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">{ col.Name }</th>
						}
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100">
					for _, row := range rows {
						<tr class="transition-colors hover:bg-slate-50">
							for i, cell := range row.Cells {
								if i == 0 {
									<td class="px-4 py-2.5 font-medium text-slate-900">
										<a href={ templ.SafeURL("/" + wsSlug + "/" + machineID + "/" + row.ID) } class="hover:text-blue-600 hover:underline">{ cell.Value }</a>
									</td>
								} else {
									<td class="px-4 py-2.5 text-slate-700">
										if cell.SlaUrgency != "" {
											@SlaBadge(cell.Value, cell.SlaUrgency)
										} else if cell.IsStatusBadge && cell.Value != "" {
											@StatusBadge(cell.Value)
										} else if cell.Value != "" {
											{ cell.Value }
										} else {
											<span class="text-slate-300">—</span>
										}
									</td>
								}
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// cardFields (CAP-V02 Tier 2) is one ListRow's own Cells collapsed onto
// RecordSummaryCard's shape -- a pure display transform of data record_crud.
// go's List already built, no new query. First Cell is the title; every
// other Cell joins into the subtitle (" · "-separated), except the first
// badge-flagged Cell among them (IsStatusBadge or SlaUrgency set), which
// becomes the card's own badge instead of subtitle text -- mirrors
// list.templ's own table rendering, which already special-cases exactly
// those two Cell flags per-cell.
type cardFields struct {
	Title         string
	Subtitle      string
	Badge         string
	IsStatusBadge bool
	SlaUrgency    string
}

func cardSummary(row ListRow) cardFields {
	if len(row.Cells) == 0 {
		return cardFields{}
	}
	cf := cardFields{Title: row.Cells[0].Value}

	// Which cell becomes the badge: the LAST badge-eligible one, not the
	// first -- caught live (2026-09-10) on vw_ad_all's own real cards:
	// Document Type (value_list, column 1) and Status (value_list, the
	// LAST column) are both badge-eligible, and picking the first found
	// Document Type as "the" badge instead of Status. By this app's own
	// column-ordering convention (every current cards-mode View puts
	// Status last -- vw_ad_all, vw_ad_pending), the rightmost eligible
	// column is the one actually worth highlighting as a badge; earlier
	// value_list columns are just descriptive category text, same as any
	// other subtitle field.
	badgeIdx := -1
	for i := 1; i < len(row.Cells); i++ {
		c := row.Cells[i]
		if (c.IsStatusBadge || c.SlaUrgency != "") && c.Value != "" {
			badgeIdx = i
		}
	}
	var subtitleParts []string
	for i := 1; i < len(row.Cells); i++ {
		c := row.Cells[i]
		if i == badgeIdx {
			cf.Badge, cf.IsStatusBadge, cf.SlaUrgency = c.Value, c.IsStatusBadge, c.SlaUrgency
			continue
		}
		if c.Value != "" {
			subtitleParts = append(subtitleParts, c.Value)
		}
	}
	cf.Subtitle = strings.Join(subtitleParts, " · ")
	return cf
}

// listCards (CAP-V02 Tier 2) is `List`'s own "cards" display mode --
// RecordSummaryCard-shaped rows instead of a `<table>`, same rows/columns
// underneath (opts.Cards, wired from ViewConfig.Display == "cards").
templ listCards(wsSlug, machineID string, rows []ListRow, archived bool) {
	if len(rows) == 0 {
		<div class="rounded-lg border border-slate-200 bg-white py-16 text-center text-sm text-slate-400">
			if archived {
				Nothing archived.
			} else {
				No records yet. Create the first one.
			}
		</div>
	} else {
		<div class="space-y-3">
			for _, row := range rows {
				if cs := cardSummary(row); row.ID != "" {
					<a
						href={ templ.SafeURL("/" + wsSlug + "/" + machineID + "/" + row.ID) }
						class="block transition-opacity hover:opacity-80"
					>
						@RecordSummaryCard(initials(cs.Title), cs.Title, cs.Subtitle, cardBadge(cs))
					</a>
				}
			}
		</div>
	}
}

// cardBadge (CAP-V02 Tier 2) resolves cardSummary's own plain-data badge
// fields into the right templ.Component for RecordSummaryCard's own badge
// slot -- SlaBadge when the source Cell carried an SlaUrgency, StatusBadge
// when it was a value_list column, nil (no badge rendered) otherwise. A
// plain Go function, not a templ block, since templ blocks don't support a
// bare variable-declaration statement -- the same reason cardSummary
// itself is a plain function.
func cardBadge(cs cardFields) templ.Component {
	switch {
	case cs.Badge == "":
		return nil
	case cs.SlaUrgency != "":
		return SlaBadge(cs.Badge, cs.SlaUrgency)
	case cs.IsStatusBadge:
		return StatusBadge(cs.Badge)
	default:
		return nil
	}
}
