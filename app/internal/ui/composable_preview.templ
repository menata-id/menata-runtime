package ui

import "menata.id/app/internal/composable"
import "menata.id/app/internal/model"

// ComposablePreview (composable-runtime-roadmap.md §17a, Live Wiring Pilot)
// renders composable.RecordSummary values directly -- proving
// internal/ui CAN consume internal/composable's own View Model types
// straight, no adapter struct needed (Gate 5 only forbids the reverse
// direction: internal/composable never imports internal/ui/store/http).
// composable-runtime-roadmap.md 17e: the card grid now reuses list.templ's
// own RecordSummaryCard/StatusBadge/Avatar/initials directly (same
// package, no import needed) -- avatar, joined subtitle, and status badge
// all included, matching the real CAP-V02 Tier 2 cards feature exactly
// (T268/T269 prove it). See ComposablePreview's own handler doc comment
// for the one named remaining gap (SlaBadge).
//
// planExplain (composable-runtime-roadmap.md 17b) is ExecutionPlan.Explain()'s
// own output from lowering this machine's FULL page (every View, not just
// the cards list rendered below) through BuildDependencyDAG/
// BuildExecutionPlan -- a side-channel diagnostic proving the Dependency
// DAG/Execution Planner boundary runs on this live request, not the data
// source for the cards grid. Rendered into a hidden data attribute (not an
// HTML comment -- untested territory for this codebase's .templ files) so
// it's inspectable via the response body without server-log access. Empty
// when the plan could not be built; renders nothing in that case.
//
// composable-runtime-roadmap.md 17f: opts now carries real search/
// pagination state (SearchQuery/Page/TotalPages/Cards), reusing List's
// own searchBox/paginationBar templ components directly (list.templ,
// same package) rather than lookalike markup -- the same "reuse, don't
// re-derive" posture 17e already established. Only rendered when
// opts.Cards (i.e. this machine actually has a cards-display View);
// the 17c fallback (no cards view at all) shows neither, since there is
// nothing real to search or paginate in that case.
templ ComposablePreview(workspaceName, wsSlug, identity, csrfToken string, isAdmin bool, machine *model.Machine, viewName string, unreadCount int, subNav []SubNavLink, summaries []composable.RecordSummary, badges []composable.StatusValue, opts ListViewOptions, planExplain string) {
	@Page(viewName, workspaceName, wsSlug, identity, csrfToken, isAdmin, unreadCount, subNav) {
		<div class="mb-4 flex items-center gap-3">
			<h1 class="flex-1 text-xl font-semibold text-slate-900">
				{ viewName }
				<span class="ml-2 inline-block rounded border border-amber-200 bg-amber-50 px-2 py-0.5 text-xs font-normal text-amber-700">Composable preview</span>
			</h1>
			if opts.Cards {
				@searchBox(wsSlug, machine.ID, opts.SearchQuery)
				<a href={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "/export.csv") } class="text-sm text-slate-500 hover:text-slate-700 transition-colors">Export</a>
				<a href={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "/import") } class="text-sm text-slate-500 hover:text-slate-700 transition-colors">Import</a>
				<a
					href={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "/new") }
					class="inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3.5 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 transition-colors"
				>
					<span>+</span>
					<span>New</span>
				</a>
			}
		</div>
		@composableCardGrid(wsSlug, machine.ID, summaries, badges, planExplain)
		if opts.Cards {
			@paginationBar(wsSlug, machine.ID, opts)
		}
	}
}

// statusBadgeComponent mirrors list.templ's own cardBadge -- simpler,
// since this pilot's own real target (mch_approval_document's vw_ad_all)
// has no SLA-eligible column, so only StatusBadge is needed here (a named
// gap, not an oversight -- see ComposablePreview's own handler doc
// comment). nil (no badge rendered) when i is out of range or the
// resolved value is empty, matching cardBadge's own "cs.Badge == ''"
// no-badge case.
func statusBadgeComponent(badges []composable.StatusValue, i int) templ.Component {
	if i >= len(badges) || badges[i].Display == "" {
		return nil
	}
	return StatusBadge(badges[i].Display)
}
