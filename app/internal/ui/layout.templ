package ui

import "strconv"

// unreadCount is CAP-A10's in-app badge -- how many of the current session's
// notifications are still unread. identity is the authenticated person's
// name (CAP-X02 -- there's no single "role" to show anymore, role is
// per-Application, see internal/handler's roleForApp). csrfToken is the
// current session's synchronizer token, needed here for the logout form.
// isAdmin shows the "Manage users" link only for a workspace Admin. Every
// page passes all five through so the nav bar renders without a separate
// request. subNav (CAP-O03 Tier 2) is the current Machine's own sibling
// Machines in the same Application -- nil/empty for a page that doesn't
// belong to any one Machine, which renders no strip at all.
//
// Mobile bottom bar (`shellBottomBar`, ADR-008 corrected by
// benchmarks/022-bottom-nav-consistency-benchmark.md, Study 30) is a fixed,
// GLOBAL 3-item set -- Home/Search/Notifications, identical on every page --
// not subNav's per-Application data. World-class bottom tab bars (Material
// Design, Apple HIG, Slack) hold their identity fixed; content that
// legitimately varies by Application belongs in the existing top subNavBar
// strip instead, same as it already did before this bar existed. Rendered
// unconditionally at phone width, on every page -- unlike subNav, this
// bar has nothing to be empty about.
templ Page(title, workspaceName, identity, csrfToken string, isAdmin bool, unreadCount int, subNav []SubNavLink) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — { workspaceName }</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
			<script src="https://unpkg.com/hyperscript.org@0.9.93" defer></script>
		</head>
		<body class="bg-slate-50 min-h-screen text-slate-900 antialiased">
			@navBar(workspaceName, identity, csrfToken, isAdmin, unreadCount)
			if len(subNav) > 0 {
				@subNavBar(subNav)
			}
			<div class="mx-auto max-w-5xl px-4 py-6 pb-20 sm:pb-6">
				{ children... }
			</div>
			@shellBottomBar(unreadCount)
			// app/ROADMAP.md Phase 4 client-side JavaScript policy correction
			// (ARCHITECTURE.md): CAP-V16 (typeahead click), CAP-V15 (live-sum
			// input), CAP-V14 (kanban drag-drop), and CAP-V21 (coordinate-
			// placement drag-drop) all moved off this page-global delegated
			// script, onto Hyperscript `_="..."` attributes colocated on
			// their own elements -- see components.templ's FieldOptionsFragment
			// and ChildLinesSection, board.templ's Board, and coordplace.templ's
			// CoordPlace for each one's own new attribute.
			//
			// CAP-V19 (below) is NOT one of the four this phase's audit named
			// (ARCHITECTURE.md's own "Correction, not carried forward" list) --
			// found live in the identical situation while doing this port, but
			// left as vanilla JS here, unconverted, since converting it wasn't
			// what this phase's plan actually scoped. Flagged, not silently
			// fixed beyond scope: a future pass should extend the same
			// Hyperscript treatment to this one too.
			<script>
				// CAP-V19: a live preview of a referenced record's own
				// field, fetched from CAP-X07's existing GET
				// /api/{machine}/{record} (no new route) as soon as a
				// reference picker's selection changes -- purely
				// presentational; the real gate is the server-side CAP-C11
				// check, unchanged. Config (which API to call, which field
				// to read) comes from the select's own data-preview-url/
				// data-preview-field attributes, never interpolated into
				// this script.
				document.addEventListener('change', function(e) {
					var el = e.target;
					var url = el.dataset.previewUrl, field = el.dataset.previewField;
					if (!url || !field) return;
					var preview = el.parentElement.querySelector('.js-live-preview');
					if (!preview) return;
					if (!el.value) { preview.textContent = '—'; return; }
					fetch(url + el.value)
						.then(function(r) { return r.json(); })
						.then(function(data) {
							var v = data && data.data ? data.data[field] : null;
							preview.textContent = (v === null || v === undefined || v === '') ? '—' : v;
						})
						.catch(function() { preview.textContent = '—'; });
				});
			</script>
		</body>
	</html>
}

// subNavBar (CAP-O03 Tier 2) renders every page belonging to a Machine
// with a persistent, Application-scoped sub-nav strip -- so a user can
// move sideways to a sibling Machine in the same Application without
// returning to the workspace home first. Server-rendered links only, no
// JS, no new route -- reuses the exact data link CAP-O03's own AppMachines
// page already resolves (Interpreter.ScopeFor/MachinesForApplication),
// just rendered persistently instead of as a one-time landing page.
templ subNavBar(links []SubNavLink) {
	<nav class="bg-slate-100 border-b border-slate-200">
		<div class="mx-auto max-w-5xl px-4 flex items-center gap-1 h-9 overflow-x-auto">
			for _, l := range links {
				<a
					href={ templ.SafeURL("/" + l.ID) }
					class={ "shrink-0 rounded px-2.5 py-1 text-xs font-medium transition-colors",
						templ.KV("bg-white text-blue-700 shadow-sm", l.Active),
						templ.KV("text-slate-500 hover:text-slate-800 hover:bg-slate-200", !l.Active) }
				>
					{ l.Name }
				</a>
			}
		</div>
	</nav>
}

// shellBottomBar is a fixed, GLOBAL bottom tab bar at phone width -- Home /
// Search / Notifications, identical on every page regardless of which
// Application or Machine is open. Corrects ADR-008's original decision to
// put subNavFor's per-Application data here instead
// (benchmarks/022-bottom-nav-consistency-benchmark.md, Study 30): Material
// Design, Apple HIG, and Slack all hold a bottom bar's own identity fixed --
// content that legitimately varies by Application belongs in subNavBar's
// existing top strip, not here. Mirrors navBar's own existing global links
// (Home is the "/" workspace-home App Launcher, already CAP-O03's own
// mechanism) -- no new route. Deliberately no active-tab highlighting yet
// (Page doesn't carry the current request path) -- a known simplification
// for this first cut, not an oversight.
templ shellBottomBar(unreadCount int) {
	<nav class="sm:hidden fixed inset-x-0 bottom-0 z-10 flex bg-white border-t border-slate-200">
		<a href="/" class="flex-1 py-3 text-center text-xs font-medium text-slate-600">
			Home
		</a>
		<a href="/search" class="flex-1 py-3 text-center text-xs font-medium text-slate-600">
			Search
		</a>
		<a href="/notifications" class="flex-1 py-3 text-center text-xs font-medium text-slate-600">
			Notifications
			if unreadCount > 0 {
				<span class="ml-1 inline-flex items-center rounded-full bg-red-100 px-1.5 py-0.5 text-xs font-medium text-red-700">
					{ strconv.Itoa(unreadCount) }
				</span>
			}
		</a>
	</nav>
}

templ navBar(workspaceName, identity, csrfToken string, isAdmin bool, unreadCount int) {
	<header class="sticky top-0 z-10 bg-white border-b border-slate-200 shadow-sm">
		<div class="mx-auto max-w-5xl px-4 flex items-center gap-4 h-12">
			<a href="/" class="font-semibold text-sm text-slate-900 hover:text-blue-600 transition-colors">
				{ workspaceName }
			</a>
			<div class="flex-1"></div>
			<a href="/search" class="text-xs text-slate-500 hover:text-slate-700 transition-colors">
				Search
			</a>
			if isAdmin {
				<a href="/admin/users" class="text-xs text-slate-500 hover:text-slate-700 transition-colors">
					Manage users
				</a>
			}
			<a href="/notifications" class="text-xs text-slate-500 hover:text-slate-700 transition-colors">
				if unreadCount > 0 {
					Notifications
					<span class="ml-1 inline-flex items-center rounded-full bg-red-100 px-1.5 py-0.5 text-xs font-medium text-red-700">
						{ strconv.Itoa(unreadCount) }
					</span>
				} else {
					Notifications
				}
			</a>
			<span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700">
				{ identity }
			</span>
			<form method="POST" action="/logout" class="inline">
				@CSRFField(csrfToken)
				<button type="submit" class="text-xs text-slate-500 hover:text-slate-700 transition-colors">
					Logout
				</button>
			</form>
		</div>
	</header>
}
