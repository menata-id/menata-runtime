package ui

// SignupInput carries back whatever the founder already typed, so a
// rejected submission (bad slug format, taken slug) re-renders with every
// other field preserved -- same UX discipline CAP-V12's wizard-step
// rejection already established, not a blank form after every mistake.
type SignupInput struct {
	Name  string
	Email string
	Slug  string
	Label string
}

// SignupPage (CAP-O09) is deliberately its own standalone shell, same
// reasoning as LoginPage: there's no identity/CSRF/unread-count to show
// before an account exists yet.
templ SignupPage(errorMsg string, in SignupInput) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Create a workspace — Menata Runtime</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
		</head>
		<body class="flex min-h-screen items-center justify-center bg-slate-50 text-slate-900 antialiased">
			<div class="mx-auto w-full max-w-sm px-4">
				<div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
					<h1 class="text-lg font-semibold text-slate-900">Create a workspace</h1>
					<p class="mt-1 text-sm text-slate-500">Founding a new workspace makes you its first Admin.</p>
					if errorMsg != "" {
						<div class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
							{ errorMsg }
						</div>
					}
					<form method="POST" action="/signup" class="mt-5 space-y-4">
						<div class="space-y-1.5">
							<label for="label" class="block text-sm font-medium text-slate-700">Workspace name</label>
							<input
								type="text"
								id="label"
								name="label"
								value={ in.Label }
								required?={ true }
								autofocus?={ true }
								class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
							/>
						</div>
						<div class="space-y-1.5">
							<label for="slug" class="block text-sm font-medium text-slate-700">Workspace URL</label>
							<div class="flex items-center rounded-md border border-slate-300 bg-white shadow-sm focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500">
								<span class="pl-3 text-sm text-slate-400">menata.app/</span>
								<input
									type="text"
									id="slug"
									name="slug"
									value={ in.Slug }
									required?={ true }
									pattern="[a-z0-9-]{3,40}"
									class="block w-full rounded-md border-0 bg-transparent px-1 py-2 text-sm focus:outline-none focus:ring-0"
								/>
							</div>
							<p class="text-xs text-slate-400">Lowercase letters, numbers, hyphens — 3 to 40 characters.</p>
						</div>
						<div class="space-y-1.5">
							<label for="name" class="block text-sm font-medium text-slate-700">Your name</label>
							<input
								type="text"
								id="name"
								name="name"
								value={ in.Name }
								required?={ true }
								class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
							/>
						</div>
						<div class="space-y-1.5">
							<label for="email" class="block text-sm font-medium text-slate-700">Email</label>
							<input
								type="email"
								id="email"
								name="email"
								value={ in.Email }
								required?={ true }
								class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
							/>
						</div>
						<div class="space-y-1.5">
							<label for="password" class="block text-sm font-medium text-slate-700">Password</label>
							<input
								type="password"
								id="password"
								name="password"
								required?={ true }
								class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
							/>
						</div>
						<button
							type="submit"
							class="inline-flex w-full items-center justify-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 transition-colors"
						>
							Create workspace
						</button>
					</form>
					<p class="mt-4 text-center text-sm text-slate-500">
						Already have a workspace? <a href="/login" class="text-blue-600 hover:text-blue-700">Log in</a>
					</p>
				</div>
			</div>
		</body>
	</html>
}
