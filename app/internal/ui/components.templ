package ui

import "strconv"
import "menata.id/app/internal/model"

// CSRFField (CAP-X02) is the hidden synchronizer-token field every
// state-changing form must include -- cmd/server/main.go's csrfProtect
// middleware rejects any non-GET request whose csrf_token doesn't match the
// session's own stored token.
templ CSRFField(token string) {
	<input type="hidden" name="csrf_token" value={ token }/>
}

// StatusBadge renders a coloured pill for status values.
templ StatusBadge(status string) {
	switch status {
	case "Draft":
		<span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{ status }</span>
	case "Submitted":
		<span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700">{ status }</span>
	case "Accepted":
		<span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">{ status }</span>
	case "Rejected":
		<span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">{ status }</span>
	case "In Progress":
		<span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">{ status }</span>
	case "Completed":
		<span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">{ status }</span>
	default:
		<span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{ status }</span>
	}
}

// SlaBadge (CAP-V17) renders a countdown-badge pill, keyed on urgency
// ("overdue"/"warning"/"ok" -- handler.slaUrgency) rather than a hardcoded
// status string, same pill convention as StatusBadge above.
templ SlaBadge(label, urgency string) {
	switch urgency {
	case "overdue":
		<span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">{ label }</span>
	case "warning":
		<span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">{ label }</span>
	default:
		<span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">{ label }</span>
	}
}

// viewNavPill (CAP-O03 Tier 3) renders a segmented pill switching between a
// Machine's own collection-level View types (List/Report/Board/Calendar/
// Timeline) -- the within-Machine nav axis, distinct from subNavBar's
// cross-Machine strip (layout.templ). Only List/Report/Board/
// CalendarTimeline's own templ callers ever pass a non-empty slice --
// Detail/Form/WizardForm pass nothing, per ADR-008 (a single record isn't a
// "view" to switch between, and a Form is a focused task).
templ viewNavPill(links []ViewNavLink) {
	<div class="mb-4 flex w-fit gap-1 rounded-md bg-slate-100 p-1">
		for _, l := range links {
			<a
				href={ templ.SafeURL(l.Path) }
				class={ "rounded px-3 py-1 text-xs font-medium transition-colors",
					templ.KV("bg-white text-slate-900 shadow-sm", l.Active),
					templ.KV("text-slate-500 hover:text-slate-800", !l.Active) }
			>
				{ l.Name }
			</a>
		}
	</div>
}

// TypeaheadPicker (CAP-V16) replaces the eager <select> for a reference/user
// field once its candidate pool exceeds handler.typeaheadThreshold -- an
// HTMX search-as-you-type fragment swap (url returns FieldOptionField
// fragments), not a hand-written fetch/JS widget. The one piece of static,
// non-interpolated JS this needs (setting the hidden field + closing the
// dropdown on click) lives once in layout.templ as a page-level delegated
// listener -- never per-field/per-option script, so there's no
// string-into-JS interpolation of a Label that might contain a quote.
templ TypeaheadPicker(name, value, label, url string) {
	<div class="relative">
		<input
			type="text"
			id={ name + "_search" }
			name="q"
			value={ label }
			placeholder="Type to search…"
			autocomplete="off"
			class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
			hx-get={ url }
			hx-trigger="keyup changed delay:300ms, focus"
			hx-target={ "#" + name + "_opts" }
		/>
		<input type="hidden" id={ name } name={ name } value={ value }/>
		<div id={ name + "_opts" } class="absolute z-10 mt-1 w-full divide-y divide-slate-100 rounded-md border border-slate-200 bg-white shadow-lg empty:hidden"></div>
	</div>
}

// FieldOptionsFragment (CAP-V16) is the HTMX-swapped response
// TypeaheadPicker's search input targets -- handler.FieldOptions renders
// this directly (not a full page). data-* attributes carry the option's id/
// label for each option's own Hyperscript click handler (app/ROADMAP.md
// Phase 4 client-side JavaScript policy correction -- this used to be a
// page-level delegated vanilla-JS listener in layout.templ) to read -- never
// interpolated into the handler itself, which would need escaping a Label as
// JS source, not just as an HTML attribute value. Hyperscript auto-wires a
// freshly HTMX-swapped-in element the same as one present at initial page
// load, so a per-option `_` attribute here needs no re-initialization step.
templ FieldOptionsFragment(target string, opts []ReferenceOption) {
	if len(opts) == 0 {
		<div class="px-3 py-2 text-sm text-slate-400">No matches</div>
	} else {
		for _, opt := range opts {
			<div
				class="field-option cursor-pointer px-3 py-2 text-sm hover:bg-slate-50"
				data-target={ target }
				data-id={ opt.ID }
				data-label={ opt.Label }
				_="on click
					js(me)
						var target = me.dataset.target;
						var hidden = document.getElementById(target);
						var search = document.getElementById(target + '_search');
						var list = document.getElementById(target + '_opts');
						if (hidden) hidden.value = me.dataset.id;
						if (search) search.value = me.dataset.label;
						if (list) list.innerHTML = '';
					end
				end"
			>{ opt.Label }</div>
		}
	}
}

// FieldInput renders the correct input element for a field type.
// refOptions is used for FieldTypeReference's, FieldTypeUser's, and
// FieldTypeGroup's picker choices (CAP-F05/CAP-F24 — `user`/`group` are
// both reference-sugar, over the workspace's own users/groups
// respectively, same picker shape, options sourced from UserStore/
// GroupStore instead of RecordStore by the caller).
// name is the HTML input's id/name -- normally f.ID, but CAP-F16's embedded
// child-line rows pass an indexed name (e.g. "child_0_fld_x") instead, so
// the same rendering logic serves both a Machine's own form fields and a
// repeated child row's fields.
templ FieldInput(f *model.Field, name, value string, refOptions []ReferenceOption, typeahead bool, typeaheadURL, typeaheadLabel string, livePreviewURL, livePreviewField, livePreviewLabel, templateLookupURL string) {
	<div class="space-y-1.5">
		<label for={ name } class="block text-sm font-medium text-slate-700">
			{ f.Name }
			if f.Required {
				<span class="text-red-500 ml-0.5">*</span>
			}
		</label>
		switch f.Type {
		case model.FieldTypeReference, model.FieldTypeUser, model.FieldTypeGroup:
			if typeahead {
				@TypeaheadPicker(name, value, typeaheadLabel, typeaheadURL)
			} else {
				<select
					id={ name }
					name={ name }
					class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
					if livePreviewURL != "" {
						data-preview-url={ livePreviewURL }
						data-preview-field={ livePreviewField }
						_="on change
							js(me)
								var url = me.dataset.previewUrl, field = me.dataset.previewField;
								var preview = me.parentElement.querySelector('.js-live-preview');
								if (!preview) return;
								if (!me.value) { preview.textContent = '—'; return; }
								fetch(url + me.value)
									.then(function(r) { return r.json(); })
									.then(function(data) {
										var v = data && data.data ? data.data[field] : null;
										preview.textContent = (v === null || v === undefined || v === '') ? '—' : v;
									})
									.catch(function() { preview.textContent = '—'; });
							end
						end"
					}
				>
					<option value="">— select —</option>
					for _, opt := range refOptions {
						<option value={ opt.ID } selected?={ opt.ID == value }>{ opt.Label }</option>
					}
				</select>
				if livePreviewURL != "" {
					<p class="text-xs text-slate-500">{ livePreviewLabel }: <span class="js-live-preview font-medium text-slate-700">—</span></p>
				}
			}
		case model.FieldTypeRichText:
			<textarea
				id={ name }
				name={ name }
				rows="3"
				class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
			>{ value }</textarea>
		case model.FieldTypeValueList:
			<select
				id={ name }
				name={ name }
				class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
				if templateLookupURL != "" {
					hx-get={ templateLookupURL }
					hx-trigger="change"
					hx-target="#child_lines_container"
					hx-swap="outerHTML"
				}
			>
				<option value="">— select —</option>
				for _, opt := range f.Options.Values {
					<option value={ opt } selected?={ opt == value }>{ opt }</option>
				}
			</select>
		case model.FieldTypeDate:
			<input
				type="date"
				id={ name }
				name={ name }
				value={ value }
				class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
			/>
		case model.FieldTypeDateTime:
			<input
				type="datetime-local"
				id={ name }
				name={ name }
				value={ value }
				class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
			/>
		case model.FieldTypeTime:
			<input
				type="time"
				id={ name }
				name={ name }
				value={ value }
				class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
			/>
		case model.FieldTypeDuration:
			<div class="flex items-center gap-2">
				<input
					type="number"
					min="0"
					id={ name }
					name={ name }
					value={ value }
					class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
				/>
				<span class="text-xs text-slate-400 whitespace-nowrap">minutes</span>
			</div>
		case model.FieldTypeNumber:
			<input
				type="number"
				step="any"
				id={ name }
				name={ name }
				value={ value }
				class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
			/>
		case model.FieldTypeMoney:
			<input
				type="number"
				step="0.01"
				id={ name }
				name={ name }
				value={ value }
				class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
			/>
		case model.FieldTypeBoolean:
			<input
				type="checkbox"
				id={ name }
				name={ name }
				value="true"
				checked?={ value == "true" }
				class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-1 focus:ring-blue-500"
			/>
		case model.FieldTypeFile:
			<input
				type="file"
				id={ name }
				name={ name }
				class="block w-full text-sm text-slate-600 file:mr-3 file:cursor-pointer file:rounded file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-slate-700 hover:file:bg-slate-200"
			/>
		default:
			<input
				type="text"
				id={ name }
				name={ name }
				value={ value }
				class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
			/>
		}
	</div>
}

// ChildLinesSection (CAP-F16) renders a fixed set of repeatable row blocks
// for a form's embedded child Machine -- Journal Entry Lines inside the
// Journal Entry form, submitted and validated atomically with the parent.
// Empty rows are simply ignored by the handler on submit, not rejected.
//
// CAP-V15: sumFieldA/B (empty = no live total shown) name the two Fields a
// live, client-side running total is kept for -- purely presentational.
// app/ROADMAP.md Phase 4 client-side JavaScript policy correction: this
// used to be read by layout.templ's page-level delegated 'input' listener;
// now it's this element's own Hyperscript `on input` handler, listening on
// itself and relying on ordinary DOM event bubbling from its own row
// inputs -- same data-sum-a-field/data-sum-b-field config attributes, same
// discipline CAP-V16's own TypeaheadPicker already established (config
// flows through data-* attributes, never string-concatenated into JS
// source).
templ ChildLinesSection(title string, rows [][]FormField, sumFieldA, sumFieldALabel, sumFieldB, sumFieldBLabel string) {
	<div
		id="child_lines_container"
		class="mt-2 space-y-3 border-t border-slate-100 pt-5"
		if sumFieldA != "" {
			data-sum-a-field={ sumFieldA }
			data-sum-b-field={ sumFieldB }
			_="on input
				js(me)
					var fa = me.dataset.sumAField, fb = me.dataset.sumBField;
					var sumA = 0, sumB = 0;
					me.querySelectorAll('input[name$=_' + fa + ']').forEach(function(i) {
						sumA += parseFloat(i.value) || 0;
					});
					if (fb) {
						me.querySelectorAll('input[name$=_' + fb + ']').forEach(function(i) {
							sumB += parseFloat(i.value) || 0;
						});
					}
					var elA = me.querySelector('.js-sum-a'), elB = me.querySelector('.js-sum-b');
					if (elA) elA.textContent = sumA.toFixed(2);
					if (elB) elB.textContent = sumB.toFixed(2);
				end
			end"
		}
	>
		<h2 class="text-sm font-semibold text-slate-700">{ title }</h2>
		for _, row := range rows {
			<div class="grid grid-cols-1 gap-3 rounded-md border border-slate-200 p-3 sm:grid-cols-2">
				for _, ff := range row {
					@FieldInput(ff.Field, ff.Name, ff.Value, ff.Options, ff.Typeahead, ff.TypeaheadURL, ff.TypeaheadLabel, ff.LivePreviewURL, ff.LivePreviewField, ff.LivePreviewLabel, ff.TemplateLookupURL)
				}
			</div>
		}
		<p class="text-xs text-slate-400">Leave a row blank to skip it.</p>
		if sumFieldA != "" {
			<div class="flex flex-wrap justify-end gap-6 rounded-md bg-slate-50 px-3 py-2 text-sm text-slate-700">
				<span>Total { sumFieldALabel }: <span class="js-sum-a font-semibold">0</span></span>
				if sumFieldB != "" {
					<span>Total { sumFieldBLabel }: <span class="js-sum-b font-semibold">0</span></span>
				}
			</div>
		}
	</div>
}

// ---------------------------------------------------------------------------
// General presentation primitives (Study 38, benchmarks/029-composed-view-
// component-inventory.md) -- extracted from recurring shapes across
// app/web/static/ui-sample/*.html, cross-checked by component-proof.html's
// own markup diff against every source mockup. Each one is a pure
// presentation primitive: no new metadata mechanism, no new capability row
// (Study 38's own verdict table). Doc comment on each names its cluster #
// and real call site(s) -- see app/docs/ui-component-library.md for the full
// catalog, including primitives NOT yet wired to a real page.
// ---------------------------------------------------------------------------

// Avatar (Study 38 Cluster 3) renders a person as a 2-letter-initials circle
// -- the single-avatar half of the Avatar/Avatar Stack cluster (8 of 14
// ui-sample mockups use this shape). Call site: AvatarStack below, and any
// future single-person context (a Detail page's own "assigned to", CAP-F05/
// CAP-F13 rendering) that wants the same visual as the group ones.
templ Avatar(initials string) {
	<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-200 text-xs font-semibold text-slate-600">{ initials }</span>
}

// AvatarStack (Study 38 Cluster 3) renders the overlapping-circle "N
// members" variant -- groups.html/group-approval.html's own group-card
// shape. Call site: AdminUsers' Groups list (admin.templ) -- replaces the
// previous plain comma-joined name list with the same visual ui-sample
// already explored, names kept alongside as the accessible text.
templ AvatarStack(initials []string) {
	<div class="flex -space-x-2">
		for _, in := range initials {
			<span class="flex h-7 w-7 items-center justify-center rounded-full border-2 border-white bg-slate-200 text-[10px] font-semibold text-slate-600">{ in }</span>
		}
	</div>
}

// RecordSummaryCard (Study 38 Cluster 2, ✓ proven by component-proof.html's
// own markup diff against 4 independent sources -- quorum-approval.html,
// requirement-checklist.html, sla-badge.html, process-map.html -- rendered
// pixel-identical from this one shape). Wrapper/avatar/title are fixed;
// subtitle and badge are the only free-text/free-content params, matching
// process-map.html's own real variance (subtitle adds "submitted by", badge
// reads "Currently: Review" not just "Review") without needing an enum.
//
// Not yet wired to a real page: this runtime's Process Overlay screens
// (CAP-W01/W03/W04/W05, the mockups' own real source) aren't ported here
// yet, and List's own row rendering (list.templ) is a table, not a card
// list -- no current View type renders one record per card. Available for
// whichever of those lands first; see app/docs/ui-component-library.md.
templ RecordSummaryCard(avatarInitials, title, subtitle string, badge templ.Component) {
	<div class="flex items-center gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm">
		@Avatar(avatarInitials)
		<div class="flex-1">
			<div class="text-sm font-semibold text-slate-900">{ title }</div>
			<div class="text-xs text-slate-400">{ subtitle }</div>
		</div>
		if badge != nil {
			@badge
		}
	</div>
}

// StickyActionBar (Study 38 Cluster 7, ✓ proven with a correction by
// component-proof.html: the original assumption -- a single disabled-
// until-ready button -- breaks on document-approval.html, which always
// shows TWO always-enabled buttons (Reject + Approve), not a state variant
// of one. Corrected shape takes an arbitrary children slot instead of a
// fixed button param, the same "0..N components" fix component-proof.html
// itself landed on.
//
// label/message may both be empty (Detail's own call below has no
// SLA/quorum context to show yet) -- the bar still renders, actions
// right-aligned, same layout `justify-between` already gives for free.
//
// Call site: Detail (detail.templ) -- the record-level Approve/Reject/
// Submit/etc. button row, moved OUTSIDE the fields card specifically so
// `position: sticky` has a real effect (an `overflow-hidden` ancestor -- the
// fields card's own rounded-corner clipping -- silently breaks sticky
// positioning, which the original inline button row sat inside).
templ StickyActionBar(label, message string) {
	<div class="sticky bottom-0 mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 bg-slate-50/95 px-5 py-4 backdrop-blur">
		if label != "" || message != "" {
			<div>
				if label != "" {
					<div class="text-xs text-slate-400">{ label }</div>
				}
				if message != "" {
					<p class="text-sm font-medium text-slate-600">{ message }</p>
				}
			</div>
		} else {
			<div></div>
		}
		<div class="flex flex-wrap items-center gap-2">
			{ children... }
		</div>
	</div>
}

// SectionWrapper (Study 38 Cluster 1) is the "title + source-View badge +
// optional action link, wraps arbitrary content" shape approval-
// dashboard.html uses 3× (Summary/Pending Documents/Recent Activity) --
// named there as the literal missing mechanism CAP-V10 Tier 2's own
// `Children` rendering needs to mark "here is where View X's data begins."
// Folds into that Tier 2's own scope per Study 38's verdict, not a
// capability row of its own.
//
// Not yet wired to a real page: CAP-V10 Tier 2 (a page composing several
// DIFFERENT Views) is still ❌ not admitted -- today's real Dashboard
// (dashboard.templ, CAP-V10 Tier 1 ✅) is one View's own Sections, not
// several Views' worth of independently-sourced content, so it has nothing
// for this wrapper to mark. Ready the moment Tier 2 lands; see
// app/docs/ui-component-library.md.
templ SectionWrapper(title, viewBadge, actionLabel, actionHref string) {
	<div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
		<div class="flex items-center justify-between gap-2">
			<h3 class="text-sm font-semibold text-slate-900">{ title }</h3>
			<div class="flex items-center gap-2">
				if viewBadge != "" {
					<span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">{ viewBadge }</span>
				}
				if actionLabel != "" {
					<a href={ templ.SafeURL(actionHref) } class="text-xs font-medium text-blue-600 hover:text-blue-800">{ actionLabel }</a>
				}
			</div>
		</div>
		<div class="mt-2">
			{ children... }
		</div>
	</div>
}

// StatTile (Study 38 Cluster 5) is the "uppercase label + large number"
// pair -- approval-dashboard.html's own Total Pending/Overdue/Due Today
// tiles, and additional A1 evidence for the already-proposed CAP-V23
// (kpi-with-delta). Deliberately renders label+value ONLY, no card chrome
// -- Dashboard's own tile link (dashboard.templ) is already a bordered,
// hoverable card, and approval-dashboard.html's own static tile wraps this
// same pair in its own card too; giving StatTile its own border would
// double it up at the one real call site this session wired.
//
// Call site: Dashboard (dashboard.templ) -- byte-identical classes to what
// was there before, only moved into a shared component, so this is a pure
// extraction with zero visual change at the existing call site.
templ StatTile(label string, value int) {
	<div class="text-xs font-semibold uppercase tracking-wide text-slate-500">{ label }</div>
	<div class="mt-1 text-2xl font-semibold text-slate-900">{ strconv.Itoa(value) }</div>
}

// ActivityFeedItem (Study 38 Cluster 6) is one narrative row -- "actor verb
// object, timestamp" -- distinct from a Divided List row by shape: this one
// has no trailing action/status, it's chronological narrative. Reinforces
// R28 (CAP-R04 → ✅ record history timeline) as a second use-case: the same
// visual shape also serves a cross-record activity feed, not just one
// record's own field-diff history.
//
// Not yet wired to a real page: nothing in this runtime today resolves a
// cross-record "who did what when" feed (CAP-R04 is scoped to one record).
// Available the moment that feed exists; see app/docs/ui-component-library.md.
templ ActivityFeedItem(actorInitials, line, meta string) {
	<li class="flex gap-3 px-4 py-3">
		@Avatar(actorInitials)
		<div class="flex-1 text-sm">
			<div class="text-slate-800">{ line }</div>
			<div class="mt-0.5 text-xs text-slate-400">{ meta }</div>
		</div>
	</li>
}

// DividedList (Study 38 Cluster 4) is the shared `<ul class="divide-y">`
// wrapper behind both ActivityFeedItem rows and any other "row: leading
// avatar/icon + content + trailing status/action" list -- generalizes
// CAP-V02's own row rendering. Distinct from Cluster 6 (ActivityFeedItem)
// by content shape (actionable/status row vs. narrative row), same wrapper
// either way.
templ DividedList() {
	<ul class="divide-y divide-slate-100">
		{ children... }
	</ul>
}

// MemberChip (Study 38 Cluster 9, additional A1 evidence for the already-
// proposed R13/CAP-F03 Tier 2) renders one Group-membership checkbox as a
// removable-looking chip -- group-detail.html's own member-chip shape --
// while staying a REAL <input type="checkbox" name="member_id"> under the
// hood, so GroupDetail's existing "Save members" POST (SetMembers, CAP-O07)
// needs no handler change at all. A checked member renders as a solid chip
// (avatar + name + ×); an unchecked candidate renders as a dashed-outline
// "+ name" pill, exactly ui-sample's own two variants.
//
// Known simplification, named rather than silently accepted: the border/
// background/text-color toggle on click is live (Hyperscript, below), but
// the avatar-vs-"+" glyph and the ×-vs-+ trailing glyph reflect this page's
// LOAD-time checked state until the form is actually submitted -- a second,
// separate live-DOM-swap step this pass didn't need for the underlying
// membership change to work correctly. Same posture as shellBottomBar's own
// "deliberately no active-tab highlighting yet" comment (layout.templ).
//
// Takes `name` only, not a separately-computed `initials` too (2026-09-07
// cleanup, same fix as CoordPlacePreview's own isPDFPreview): initials(name)
// is a pure function of name with nothing else in it, so computing it here
// instead of trusting a second, independently-passed parameter removes one
// more place the two could in principle disagree.
templ MemberChip(id, name string, checked bool) {
	<label
		class={ "inline-flex cursor-pointer items-center gap-2 rounded-full border py-1 pl-1 pr-2 text-sm transition-colors",
			templ.KV("border-slate-200 bg-slate-50 text-slate-700", checked),
			templ.KV("border-dashed border-slate-300 text-slate-500 hover:border-blue-300 hover:text-blue-600", !checked) }
		_="on change from <input/> in me
			toggle .border-slate-200 .bg-slate-50 .text-slate-700 on me
			toggle .border-dashed .border-slate-300 .text-slate-500 on me
		end"
	>
		<input type="checkbox" name="member_id" value={ id } checked?={ checked } class="sr-only"/>
		if checked {
			<span class="flex h-5 w-5 items-center justify-center rounded-full bg-slate-200 text-[10px] font-semibold text-slate-600">{ initials(name) }</span>
		}
		{ name }
		if checked {
			<span class="text-slate-400">×</span>
		} else {
			<span class="text-slate-400">+</span>
		}
	</label>
}
