package ui

import "menata.id/app/internal/composable"
import "menata.id/app/internal/model"

// PreviewDetailField (composable-runtime-roadmap.md 17m) pairs one
// composable.FieldValue with its own Field's display Name -- the same
// ColumnDef-style pairing renderPageListChild already does for table
// columns, done here for a Detail's own field/value list.
type PreviewDetailField struct {
	Name  string
	Value composable.FieldValue
}

// RecordComposablePreview (composable-runtime-roadmap.md 17m, Detail-Page
// Composition Pilot) renders one record's own field list, resolved
// entirely through internal/composable (BuildDatasetFromView ->
// LowerCollection -> ResolveCollectionItem) -- the Detail-page
// counterpart to ComposablePreview's own List/Board rendering. See
// internal/handler/composable_preview_detail.go's own doc comment for the
// named boundary (raw stored ids, no label dereferencing) this preview
// does not overclaim past.
templ RecordComposablePreview(workspaceName, wsSlug, identity, csrfToken string, isAdmin bool, machine *model.Machine, viewName string, fields []PreviewDetailField, unreadCount int, subNav []SubNavLink) {
	@Page(viewName, workspaceName, wsSlug, identity, csrfToken, isAdmin, unreadCount, subNav) {
		<div class="mb-4">
			<h1 class="text-xl font-semibold text-slate-900">
				{ viewName }
				<span class="ml-2 inline-block rounded border border-amber-200 bg-amber-50 px-2 py-0.5 text-xs font-normal text-amber-700">Composable preview</span>
			</h1>
		</div>
		<div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
			<dl class="divide-y divide-slate-100">
				for _, f := range fields {
					<div class="flex gap-4 py-2">
						<dt class="w-36 shrink-0 text-sm font-medium text-slate-500">{ f.Name }</dt>
						<dd class="flex-1 text-sm text-slate-900">
							if f.Value.Display == "" {
								<span class="text-slate-400">—</span>
							} else {
								{ f.Value.Display }
							}
						</dd>
					</div>
				}
			</dl>
		</div>
	}
}
