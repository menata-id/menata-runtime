package ui

import "menata.id/app/internal/model"
import "menata.id/app/internal/store"

// planExplain (composable-runtime-roadmap.md 17o), when non-empty, is
// 17b's own Dependency DAG/Execution Planner diagnostic -- the exact same
// pattern list.templ/board.templ already use. Empty whenever no real
// Detail View is declared for this Machine (the field list then falls
// back to its own pre-17o behavior, untouched).
templ Detail(workspaceName, wsSlug, identity, csrfToken string, isAdmin bool, machine *model.Machine, record *store.Record, fields []DetailField, permittedEvents []EventTrigger, childLists []ChildList, unreadCount int, subNav []SubNavLink, extraLinks []DetailLink, embedded []EmbeddedSection, planExplain string) {
	@Page(machine.Name + " — Detail", workspaceName, wsSlug, identity, csrfToken, isAdmin, unreadCount, subNav) {
		if planExplain != "" {
			<div class="hidden" data-composable-plan={ planExplain }></div>
		}
		<div class="mx-auto max-w-2xl">
			<div class="mb-5 flex items-center gap-3">
				<a
					href={ templ.SafeURL("/" + wsSlug + "/" + machine.ID) }
					class="text-sm text-slate-400 hover:text-slate-600 transition-colors"
				>← Back</a>
				<h1 class="flex-1 text-xl font-semibold text-slate-900">{ machine.Name }</h1>
				for _, link := range extraLinks {
					<a
						href={ templ.SafeURL(link.URL) }
						class="text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors"
					>{ link.Label }</a>
				}
			</div>
			<div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
				<dl class="divide-y divide-slate-100">
					for _, f := range fields {
						<div class="flex gap-4 px-5 py-3.5">
							<dt class="w-36 shrink-0 text-sm font-medium text-slate-500">{ f.Name }</dt>
							<dd class="flex-1 text-sm text-slate-900">
								if f.Value == "" {
									<span class="text-slate-300">—</span>
								} else if f.SlaUrgency != "" {
									@SlaBadge(f.Value, f.SlaUrgency)
								} else if f.Link != "" {
									<a href={ templ.SafeURL(f.Link) } class="text-blue-600 hover:text-blue-800 hover:underline">{ f.Value }</a>
								} else {
									@StatusBadge(f.Value)
								}
							</dd>
						</div>
						if f.IsFile && f.Value != "" && isPDFPreview(f.Value) {
							<div class="border-t border-slate-100 px-5 py-3.5">
								<object type="application/pdf" data={ templ.SafeURL(f.Link) } class="h-96 w-full rounded-md border border-slate-200"></object>
							</div>
						}
					}
				</dl>
			</div>
			for _, sec := range embedded {
				<div class="mt-4">
					@SectionWrapper(sec.Title, "", sec.ActionLabel, sec.ActionHref) {
						@sec.Content
					}
				</div>
			}
			if len(permittedEvents) > 0 {
				@StickyActionBar("", "") {
					for _, trig := range permittedEvents {
						<form
							method="POST"
							action={ templ.SafeURL("/" + wsSlug + "/" + machine.ID + "/" + record.ID + "/events/" + trig.Event.ID) }
							class="flex items-end gap-2"
						>
							@CSRFField(csrfToken)
							for _, inp := range trig.Inputs {
								@FieldInput(inp.Field, inp.Name, inp.Value, inp.Options, inp.Typeahead, inp.TypeaheadURL, inp.TypeaheadLabel, inp.LivePreviewURL, inp.LivePreviewField, inp.LivePreviewLabel, inp.TemplateLookupURL)
							}
							<button
								type="submit"
								class="inline-flex items-center rounded-md bg-slate-900 px-3.5 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-1 transition-colors"
							>
								{ trig.Event.Name }
							</button>
							if trig.Event.DeprecatedMessage != "" {
								<span
									class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700"
									title={ trig.Event.DeprecatedMessage }
								>Deprecated</span>
							}
						</form>
					}
				}
			}
			for _, cl := range childLists {
				<div class="mt-5 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
					<div class="border-b border-slate-100 bg-slate-50 px-5 py-2.5 text-sm font-medium text-slate-700">
						{ cl.Title }
					</div>
					<ul class="divide-y divide-slate-100">
						for _, item := range cl.Items {
							<li class="px-5 py-2.5 text-sm">
								<a href={ templ.SafeURL(item.Link) } class="text-blue-600 hover:text-blue-800 hover:underline">{ item.Label }</a>
							</li>
						}
					</ul>
				</div>
			}
		</div>
	}
}
